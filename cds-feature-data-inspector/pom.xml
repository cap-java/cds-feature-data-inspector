<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sap.cds</groupId>
    <artifactId>cds-feature-data-inspector-root</artifactId>
    <version>${revision}</version>
  </parent>

  <!--
        The reusable CAP Java plugin library (OData services only; the SAPUI5 UI
        ships separately via the @cap-js/data-inspector npm package).

        Consumers add this as a Maven dependency and reference its CDS model with
        `using from 'com.sap.cds/cds-feature-data-inspector';`. The handlers are
        auto-registered via META-INF/services/…CdsRuntimeConfiguration — no further
        wiring required.
    -->
  <!-- organization / licenses / developers / scm are inherited from the published parent (-root) POM. -->
  <artifactId>cds-feature-data-inspector</artifactId>
  <packaging>jar</packaging>
  <name>CDS Feature: Data Inspector</name>
  <description>CAP Java plugin: OData services to browse CDS entity definitions and live data.</description>
  <url>https://github.com/cap-java/cds-feature-data-inspector</url>

  <dependencies>
    <!-- CAP Java runtime API — the interfaces/annotations this plugin's handlers are built on (EventHandler, CqnService, CdsModel, …). Also pulls slf4j-api transitively. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-services-api</artifactId>
    </dependency>

    <!-- Jackson module to serialise java.time.* as ISO-8601 in the 'record' JSON. Explicit version: not managed by cds-services-bom. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.jsr310.version}</version>
    </dependency>

    <!-- Test: JUnit 5 test framework (version from junit-bom). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test: AssertJ fluent assertions. -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Test: CAP Java (cds4j) runtime, needed to initialise com.sap.cds.ql.CQL in RFilterParserTest; not managed by cds-services-bom. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds4j-runtime</artifactId>
      <version>${cds.services.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <!-- Compiles the plugin's own CDS model. No resolve/deploy: no external CDS deps, entities are @cds.persistence.skip (served by @On handlers). -->
      <plugin>
        <groupId>com.sap.cds</groupId>
        <artifactId>cds-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>cds.install-node</id>
            <goals>
              <goal>install-node</goal>
            </goals>
          </execution>
          <execution>
            <id>cds.npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <commands>
                <command>ci</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.build</id>
            <goals>
              <goal>cds</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commands>
                <command>build --for java</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.generate</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <basePackage>com.sap.cds.feature.datainspector</basePackage>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Unit-test coverage → target/jacoco.exec; merged by the coverage-report module. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>test</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
