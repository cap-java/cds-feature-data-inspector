<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
        Root (aggregator) POM. Multi-module build:
          cds-feature-data-inspector/  ← the reusable plugin library (the ONLY published artifact)
          test-app/                    ← private sample consumer app (smoke tests, not published)
          coverage-report/             ← aggregated JaCoCo report (not published)
    -->

  <groupId>com.sap.cds</groupId>
  <artifactId>cds-feature-data-inspector-root</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>CDS Feature: Data Inspector — Root</name>
  <description>Aggregator POM for the cds-feature-data-inspector CAP Java plugin
        and its bundled test-app consumer application.</description>
  <url>https://github.com/cap-java/cds-feature-data-inspector</url>

  <organization>
    <name>SAP SE</name>
    <url>https://www.sap.com</url>
  </organization>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <organization>SAP SE</organization>
      <organizationUrl>https://www.sap.com</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>cds-feature-data-inspector</module>
    <module>test-app</module>
    <!-- Listed last: merges the above two modules' JaCoCo exec data into one report. -->
    <module>coverage-report</module>
  </modules>

  <!-- append.path="false": children inherit these SCM URLs verbatim (no module path appended → no doubled path in the published plugin POM). -->
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:git@github.com:cap-java/cds-feature-data-inspector.git</connection>
    <developerConnection>scm:git:git@github.com:cap-java/cds-feature-data-inspector.git</developerConnection>
    <url>https://github.com/cap-java/cds-feature-data-inspector</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>central</id>
      <name>MavenCentral</name>
      <url>https://central.sonatype.com</url>
    </repository>
    <snapshotRepository>
      <id>artifactory</id>
      <name>Artifactory_DMZ-snapshots</name>
      <url>https://common.repositories.cloud.sap/artifactory/cap-java</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <!-- CI-friendly version placeholder, resolved at build time by flatten-maven-plugin. -->
    <revision>1.0.0</revision>

    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- CDS version — governs cds-services-* and cds-feature-* (and the cds-maven-plugin). -->
    <cds.services.version>5.2.0</cds.services.version>

    <cds.cdsdk.version>10.0.4</cds.cdsdk.version>

    <!--
            Must match the Spring Boot version CAP Java ${cds.services.version} pulls in
            transitively (verify with `mvn dependency:tree` on a bump). Imported only by
            test-app — kept out of root dependencyManagement so it never dictates the
            published plugin's dependency versions.
        -->
    <spring.boot.version>4.1.1</spring.boot.version>

    <junit.bom.version>6.1.3</junit.bom.version>

    <!-- Not managed by cds-services-bom; pinned explicitly. -->
    <assertj.version>3.27.7</assertj.version>

    <!-- Explicit pin for jackson-datatype-jsr310 (used by the plugin's JSON handling). -->
    <jackson.jsr310.version>2.22.4</jackson.jsr310.version>

    <!-- Skip Spotless `check` in normal builds; run `mvn spotless:apply`/`:check` on demand. -->
    <spotless.check.skip>true</spotless.check.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- CAP Java BOM: aligns versions of all com.sap.cds:* artifacts (and their deps like jackson) across modules. -->
      <dependency>
        <groupId>com.sap.cds</groupId>
        <artifactId>cds-services-bom</artifactId>
        <version>${cds.services.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- JUnit 5 BOM: aligns junit-jupiter versions for tests. Spring Boot BOM is intentionally NOT imported here — see spring.boot.version note. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
        pluginManagement = a version/config CATALOG only; nothing runs here. Child modules
        (and this pom's <build><plugins>) reference these plugins without repeating versions.
    -->
  <build>
    <pluginManagement>
      <plugins>
        <!-- Compiles Java sources (to the Java release set above). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <!-- Runs unit tests (*Test.java) in the `test` phase. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <!-- Runs integration tests (*IT.java) in the `integration-test`/`verify` phases. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <!-- Enforces build rules (min Maven/Java version, no duplicate deps). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <!-- Uploads artifacts to a repository on `mvn deploy`. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <!-- Builds the sources jar (Central requirement); used by the deploy-release profile. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- Builds the javadoc jar (Central requirement); used by the deploy-release profile. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <!-- GPG-signs artifacts (Central requirement); used by the deploy-release profile. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <!-- Publishes to Maven Central via the Sonatype Central Portal. -->
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
          <extensions>true</extensions>
        </plugin>
        <!-- Resolves CI-friendly ${revision} into the published POM. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.8.0</version>
        </plugin>
        <!-- Repackages the test-app into a runnable Spring Boot jar (`spring-boot:run`/repackage). -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>
        <!-- Compiles *.cds → EDMX + Java accessors; version must match cds.services.version. -->
        <plugin>
          <groupId>com.sap.cds</groupId>
          <artifactId>cds-maven-plugin</artifactId>
          <version>${cds.services.version}</version>
        </plugin>
        <!-- Measures test coverage (per-module exec files, merged by coverage-report). -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.15</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Resolves ${revision} to a concrete version in the published POM. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Sanity guardrails matching cds-feature-attachments/-auditlog-ng. -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-duplicate-declared-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <banDuplicatePomDependencyVersions/>
                <requireMavenVersion>
                  <version>3.6.3</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>${java.version}</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- `mvn spotless:apply` to fix formatting, `:check` to verify. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <licenseHeader>
              <content>/*
 * © $YEAR SAP SE or an SAP affiliate company and cds-feature-data-inspector contributors.
 */</content>
            </licenseHeader>
          </java>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom/>
          </pom>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
            Maven Central release (`mvn deploy -Pdeploy-release`): attach sources+javadoc,
            GPG-sign, publish via central-publishing. The parent (-root) POM is published
            too so the plugin can inherit org/license/scm/developers from it;
            excludeArtifacts keeps the non-publishable test-app and coverage-report off Central.
        -->
    <profile>
      <id>deploy-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals>
                  <goal>sign</goal>
                </goals>
                <phase>deploy</phase>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <excludeArtifacts>
                <excludeArtifact>cds-feature-data-inspector-test-app</excludeArtifact>
                <excludeArtifact>cds-feature-data-inspector-coverage-report</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
