{
  "//": "CAP tooling config. Equivalent to the `cds:` block in a Node.js package.json.",

  "build": {
    "target": ".",
    "tasks": [
      {
        "for": "java",
        "src": "srv",
        "dest": ".",
        "options": {
          "model": [
            "db",
            "srv",
            "target/cds/com.sap.cds/cds-feature-data-inspector"
          ]
        }
      },
      {
        "for": "data-inspector"
      }
    ]
  },

  "requires": {
    "@cap-js/data-inspector": false,
    "db": {
      "kind": "sql"
    },
    "[development]": {
      "db": { "kind": "sqlite", "credentials": { "url": "sqlite.db" } }
    },
    "[cloud]": {
      "db": { "kind": "hana", "vcap": { "label": "hana" } },
      "auth": { "kind": "xsuaa" }
    }
  }
}