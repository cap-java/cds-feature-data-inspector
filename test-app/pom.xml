<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sap.cds</groupId>
    <artifactId>cds-feature-data-inspector-root</artifactId>
    <version>${revision}</version>
  </parent>

  <!--
        Private sample consumer app showing how a downstream project wires in the
        plugin. Standard CAP layout (db/, srv/, src/). Run: `mvn -pl test-app spring-boot:run`.
    -->
  <artifactId>cds-feature-data-inspector-test-app</artifactId>
  <packaging>jar</packaging>
  <name>CDS Feature: Data Inspector — Test App</name>
  <description>Sample CAP Java application consuming the cds-feature-data-inspector plugin.
        Used only for local development / smoke tests. Not published.</description>

  <properties>
    <cds.output.dir>${project.build.directory}/cds</cds.output.dir>

    <!-- Never publish the test-app. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- The plugin under test. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-data-inspector</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- CAP Java runtime: OData v4 + Spring Boot (pulls in cds-services-impl, jackson, spring-web). -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-starter-spring-boot-odata</artifactId>
    </dependency>

    <!-- SQLite for local dev (version managed by cds-services-bom). -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-jdbc</artifactId>
    </dependency>

    <!-- HANA client — 'cloud' profile only. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-hana</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- XSUAA — 'cloud' profile only. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-identity</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Mock-user / role-based auth for local dev and the IT suite. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Audit logging (v2); exercised by DataHandlerAuditLogIT. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-auditlog-v2</artifactId>
    </dependency>

    <!-- ─────────── Test dependencies (integration tests) ─────────── -->

    <!-- Spring Boot test starter — JUnit 5, AssertJ, MockMvc for the @SpringBootTest IT suite. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Security test helpers — httpBasic() to authenticate MockMvc requests. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
            NOTE: do NOT declare jackson-databind here. It's already on the runtime
            classpath transitively; a test-scoped declaration would (via "nearest wins")
            demote it to test scope and break `spring-boot:run` with NoClassDefFoundError.
        -->
  </dependencies>

  <build>
    <finalName>cds-feature-data-inspector-test-app</finalName>

    <plugins>
      <!--
                Spring Boot fat-jar packaging. classifier=exec keeps the thin jar as the
                primary artifact (needed by failsafe's test classpath) and writes the fat
                jar as `…-exec.jar`; without it, `repackage` breaks `mvn verify`.
            -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
                CDS build lifecycle: install-node + npm ci (installs @sap/cds-dk) →
                resolve (pulls the plugin's CDS model from its JAR into target/cds/) →
                cds build (merged model → CSN/EDMX) → generate (Java accessors) →
                cds deploy (creates & seeds sqlite.db for local dev).
            -->
      <plugin>
        <groupId>com.sap.cds</groupId>
        <artifactId>cds-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>cds.install-node</id>
            <goals>
              <goal>install-node</goal>
            </goals>
          </execution>
          <execution>
            <id>cds.npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <commands>
                <command>ci</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.resolve</id>
            <goals>
              <goal>resolve</goal>
            </goals>
          </execution>
          <execution>
            <id>cds.build</id>
            <goals>
              <goal>cds</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commands>
                <command>build --for java</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.generate</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <basePackage>com.sap.cds.feature.datainspector.testapp</basePackage>
            </configuration>
          </execution>
          <execution>
            <id>cds.deploy</id>
            <goals>
              <goal>cds</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commands>
                <command>deploy --to sqlite:sqlite.db</command>
              </commands>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire runs *Test.java (`test` phase); Failsafe runs the *IT.java suite (`verify` phase). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo: record integration-test coverage into target/jacoco.exec; merged by the coverage-report module. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
