<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sap.cds</groupId>
    <artifactId>cds-feature-data-inspector-root</artifactId>
    <version>${revision}</version>
  </parent>

  <!--
        Private sample consumer app showing how a downstream project wires in the
        plugin. Standard CAP layout (db/, srv/, src/). Run: `mvn -pl test-app spring-boot:run`.
    -->
  <artifactId>cds-feature-data-inspector-test-app</artifactId>
  <packaging>jar</packaging>
  <name>CDS Feature: Data Inspector — Test App</name>
  <description>Sample CAP Java application consuming the cds-feature-data-inspector plugin.
        Used only for local development / smoke tests. Not published.</description>

  <properties>
    <cds.output.dir>${project.build.directory}/cds</cds.output.dir>

    <!-- Never publish the test-app. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The plugin under test. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-data-inspector</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-starter-spring-boot-odata</artifactId>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-jdbc</artifactId>
    </dependency>

    <!-- 'cloud' profile only. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-hana</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-identity</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Exercised by DataHandlerAuditLogIT. -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-auditlog-v2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Do NOT declare jackson-databind here: a test-scoped decl would (nearest-wins) demote the transitive runtime one and break `spring-boot:run`. -->
  </dependencies>

  <build>
    <finalName>cds-feature-data-inspector-test-app</finalName>

    <plugins>
      <!-- classifier=exec keeps the thin jar as the primary artifact (failsafe's test classpath); the fat jar becomes `…-exec.jar`. Without it, repackage breaks `mvn verify`. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- CDS lifecycle: npm ci → resolve (plugin model from its JAR) → build → generate → deploy (seeds sqlite.db). -->
      <plugin>
        <groupId>com.sap.cds</groupId>
        <artifactId>cds-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>cds.install-node</id>
            <goals>
              <goal>install-node</goal>
            </goals>
          </execution>
          <execution>
            <id>cds.npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <commands>
                <command>ci</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.resolve</id>
            <goals>
              <goal>resolve</goal>
            </goals>
          </execution>
          <execution>
            <id>cds.build</id>
            <goals>
              <goal>cds</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commands>
                <command>build --for java</command>
              </commands>
            </configuration>
          </execution>
          <execution>
            <id>cds.generate</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <basePackage>com.sap.cds.feature.datainspector.testapp</basePackage>
            </configuration>
          </execution>
          <execution>
            <id>cds.deploy</id>
            <goals>
              <goal>cds</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commands>
                <command>deploy --to sqlite:sqlite.db</command>
              </commands>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Failsafe runs the *IT suite at `verify`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- IT coverage → target/jacoco.exec; merged by the coverage-report module. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
